# Last 30 Days Skill - API Keys
# Copy this file to .env and fill in your API keys

# XAI API Key for Grok (X/Twitter search)
# Get your key at: https://console.x.ai/
XAI_API_KEY=your_xai_key_here

# Optional Xquik API key for direct X/Twitter data search
# Get your key from the Xquik dashboard
XQUIK_API_KEY=your_xquik_key_here

# Optional: choose xai or xquik for the X/Twitter phase
LAST30DAYS_X_PROVIDER=xai

# OpenAI API Key (Reddit search via ChatGPT)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
